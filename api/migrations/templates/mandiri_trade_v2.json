{
  "key": "mandiri",
  "broker_name": "Mandiri Sekuritas",
  "version": 1,
  "email_sender": "cc_admin@mandirisekuritas.co.id",
  "subject_contains": "TC-",
  "filename_suffix": ".pdf",
  "config": {
    "schema_version": 2,
    "document": "pdf",
    "kind": "trade",
    "parse_mode": "metadata",
    "subject_pattern": "(?i)^TC-[A-Z0-9]+-[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$",
    "required_markers": ["PT\\. MANDIRI SEKURITAS", "TRADE CONFIRMATION", "Total Charges"],
    "date": {"pattern": "Transaction Date[ \\t]*:[ \\t]*[A-Za-z]+,[ \\t]*([A-Za-z]+ [0-9]{1,2}, [0-9]{4})", "group": 1, "layout": "January 2, 2006"},
    "numbers": {"decimal_separator": ".", "thousands_separator": ",", "grouping_size": 3},
    "shares_per_lot": 100,
    "table": {
      "start_pattern": "(?m)^[ \\t]*No[ \\t]+Board[ \\t]+Securities[ \\t]+Lots[ \\t]+Shares[ \\t]+Price[ \\t]+Buy[ \\t]+Sell[ \\t]*\\r?\\n",
      "end_pattern": "(?m)^[^\\r\\n]*Gross Amount",
      "row_pattern": "(?m)(?:^[ \\t]*(?:BUY|SELL)[ \\t]*\\r?\\n)*^[ \\t]*[0-9]+[ \\t]+[A-Z]{2}[ \\t]+([A-Z0-9]{4})-[^\\r\\n]+?[ \\t]{2,}([\\d,.]+)[ \\t]+([\\d,.]+)[ \\t]+([\\d,.]+)[ \\t]+([\\d,.]+)[ \\t]+([\\d,.]+)[ \\t]*(?:\\r?\\n|$)(?:^[ \\t]{10,}[A-Za-z][^\\r\\n]*\\r?\\n)*",
      "fields": {"ticker": 1, "lot": 2, "quantity": 3, "price": 4, "buy_amount": 5, "sell_amount": 6}
    },
    "trade": {
      "extraction": "layout",
      "password_source": "broker",
      "ignore_patterns": ["(?ms)^[ \\t]*For further information, please call our Care Center Officer[^\\r\\n]*\\r?\\n.*?^[ \\t]*No[ \\t]+Board[ \\t]+Securities[ \\t]+Lots[ \\t]+Shares[ \\t]+Price[ \\t]+Buy[ \\t]+Sell[ \\t]*\\r?\\n"],
      "reference_fields": {"confirmation": {"source": "body", "pattern": "Our Ref\\.[ \\t]*:[ \\t]*([0-9]+)", "group": 1}},
      "ref_template": "MANDIRI-{confirmation}-{ticker}-{sequence}",
      "fee_allocation": "side",
      "buy_fallback_rate": 0,
      "sell_fallback_rate": 0,
      "sell_amount": "add",
      "fees": [
        {"pattern": "(?m)Total Charges[ \\t]+([\\d,.]+)[ \\t]+([\\d,.]+)[ \\t]*$", "buy_group": 1, "sell_group": 2},
        {"pattern": "(?m)Sales Tax[ \\t]+(?:[\\d.]+%[ \\t]+)?([\\d,.]+)[ \\t]*$", "sell_group": 1}
      ]
    }
  }
}
