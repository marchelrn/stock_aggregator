        "fee_allocation": "all",
        "buy_fallback_rate": 0.0015, "sell_fallback_rate": 0.0025,
        "sell_amount": "subtract",
        "fees": [{"pattern": "(?m)Total Pembebanan[ \\t]+([\\d,.]+)[ \\t]*$", "total_group": 1}]
      }
    }
  },
