PORT=3030
ENV=development
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

DB_USER=ur_database_user
DB_PASS=ur_database_password
DB_HOST=ur_database_host
DB_PORT=ur_database_port
DB_NAME=ur_database_name

FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3030/auth/google/callback

# Set to false once every broker has a parsing template in the database.
# When false, emails that match no template are rejected instead of using the
# legacy hardcoded extractor.
PDF_PARSER_FALLBACK=true

# Compare successful metadata results with legacy results in logs, without
# replacing the metadata result or saving extra transactions.
PDF_PARSER_COMPARE=false
